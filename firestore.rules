rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isStaff() {
      return isAuthenticated() && getUserRole() in [
        'SUPER_ADMIN', 'HEAD_LIBRARIAN', 'LIBRARIAN', 
        'CASHIER', 'INVENTORY_STAFF', 'PROCUREMENT_STAFF', 'AUDITOR'
      ];
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'SUPER_ADMIN';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // System Settings: Publicly readable, Super Admin writable
    match /librarySettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Branches: Publicly readable, Staff writable
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Books (Catalogue): Publicly readable, Staff writable
    match /books/{bookId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Book Copies: Publicly readable for availability, Staff writable
    match /bookCopies/{copyId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Member Profiles
    match /members/{memberId} {
      allow read: if isOwner(memberId) || isStaff();
      // Status and financial fields can ONLY be written by backend Functions
      allow write: if false;
    }

    // Circulation Loans: Patron can read their own loans; staff can read all
    match /loans/{loanId} {
      allow read: if (isAuthenticated() && resource.data.memberId == request.auth.uid) || isStaff();
      // Circulation state modifications are restricted to trusted Cloud Functions
      allow write: if false;
    }

    // Reservations / Holds
    match /reservations/{resId} {
      allow read: if (isAuthenticated() && resource.data.memberId == request.auth.uid) || isStaff();
      allow write: if false;
    }

    // Financial Ledgers: Append-only, never modifiable or deletable
    match /ledgerEntries/{entryId} {
      allow read: if isStaff();
      allow write: if false; // Writes strictly emitted by backend Cloud Functions
    }

    // Audit Logs: Append-only, read-only for Auditors & Admins
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || getUserRole() == 'AUDITOR';
      allow write: if false; // Writes strictly emitted by trusted Cloud Functions
    }
  }
}
